# Environment Configuration

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_NAME="ASKAI"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_DEVICE_NAME="ASKAI Hub"

# ============================================
# SERVER
# ============================================
# Bind to 0.0.0.0 for LAN access
HOST=0.0.0.0
PORT=3000

# ============================================
# DATABASE
# ============================================
DATABASE_URL="file:./askai.db"

# ============================================
# AUTH
# ============================================
# Generate a strong secret: openssl rand -base64 32
SESSION_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS"
ADMIN_USERNAME="admin"
# bcrypt hash of "askai123" — change immediately in production
ADMIN_PASSWORD_HASH="$2b$10$1BMjEZBz/.cbo08X8aM0m.5wbM6ZUZnrR1cZ1dkN6XMWN2iA.hu/C"

# ============================================
# AI SERVICE
# ============================================
AI_SERVICE_URL="http://localhost:8000"
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_CHAT_MODEL="gemma3:1b"
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"

# ============================================
# KOLIBRI
# ============================================
KOLIBRI_BASE_URL="http://localhost:8080"
KOLIBRI_ENABLED="true"

# ============================================
# FEATURES
# ============================================
FEATURE_RAG_ENABLED="true"
FEATURE_KNOWLEDGE_ENABLED="true"
FEATURE_ADMIN_ENABLED="true"
FEATURE_LEARN_ENABLED="true"
